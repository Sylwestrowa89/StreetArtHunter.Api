{
  "version": "2.0",
  "logging": {
    "logLevel": {
      "default": "Error",
      "Host": "Error",
      "Function": "Information",
      "Host.Aggregator": "Information",
      "StreetArtHunter.Api": "Information"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  }
}